# What git ignores in this repo, and why.
# Rule of thumb: track everything authored; ignore anything a tool regenerates.

# Windows shortcuts
*.lnk

# ---------------------------------------------------------------
# Visual Studio (externals/*/build/windows)
# Caches, intermediate files and build output: all regenerated on build.
# The .sln, .vcxproj and .vcxproj.filters ARE tracked: they hold the build settings.
# Release DLLs are copied by hand into externals/*/bin/, which is tracked.
# ---------------------------------------------------------------
.vs/
*.user
x64/
x86/
[Dd]ebug/
[Rr]elease/
*.obj
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.log
*.recipe
*.lastbuildstate
*.exp
*.lib

# ---------------------------------------------------------------
# Unity project (unity/Patchland/)
# Only small, authored parts are tracked: scripts, scenes, input mapping,
# project settings and the package list. Everything else (Library, 3D models,
# Blender files, textures, audio, Starter Assets) is either regenerated by Unity
# or backed up separately, because it's far too big for GitHub.
# ---------------------------------------------------------------
/unity/Patchland/*
!/unity/Patchland/Assets/
/unity/Patchland/Assets/*
!/unity/Patchland/Assets/Scripts/
!/unity/Patchland/Assets/Scripts.meta
!/unity/Patchland/Assets/Scenes/
!/unity/Patchland/Assets/Scenes.meta
!/unity/Patchland/Assets/InputSystem_Actions.inputactions
!/unity/Patchland/Assets/InputSystem_Actions.inputactions.meta
!/unity/Patchland/ProjectSettings/
!/unity/Patchland/Packages/
/unity/Patchland/Packages/*
!/unity/Patchland/Packages/manifest.json
!/unity/Patchland/Packages/packages-lock.json
